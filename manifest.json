{
  "schema": "pi-bootstrap.manifest/1",
  "updated": "2026-11-05",
  "installPrefix": "~/.local",
  "tiers": {
    "base": [
      "node",
      "pi",
      "gentle-ai"
    ],
    "tools": [
      "engram",
      "codegraph"
    ],
    "shell": [
      "gentle-shell"
    ],
    "auth:claude": [
      "claude-code"
    ]
  },
  "tools": {
    "node": {
      "kind": "tarball",
      "version": "24.22.2",
      "requires": [],
      "url": "https://nodejs.org/dist/v{version}/node-v{version}-{os}-{arch}.tar.gz",
      "sha256": {
        "darwin-arm64": "aa9549349e47dffaa42dcf95d6e06ade8c4bdafc980979883b88767670df385a",
        "darwin-x64": "d5e336d588c45be0c37dbd52cc29895593009ca4997a77a1fd02815131ed0e52",
        "linux-arm64": "95c264150aceb7f3437a29fd6984924f5f8d1511ea3cbd6c508b83f6c555dae2",
        "linux-x64": "361718c444e49af2ca5a110c83ba6a8901143f23ab285ebbef0341f391f482a9"
      },
      "dest": "~/.local/node",
      "stripComponents": 1,
      "exposes": [
        "node",
        "npm",
        "npx"
      ],
      "verify": [
        "node --version",
        "npm --version"
      ]
    },
    "pi": {
      "kind": "npm-global",
      "package": "@earendil-works/pi-coding-agent",
      "version": "1.5.0",
      "requires": [
        "node"
      ],
      "exposes": [
        "pi"
      ],
      "verify": [
        "pi --version"
      ]
    },
    "gentle-ai": {
      "kind": "tarball",
      "version": "4.3.1",
      "requires": [],
      "url": "https://github.com/Gentleman-Programming/gentle-ai/releases/download/v{version}/gentle-ai_{version}_{os}_{arch}.tar.gz",
      "sha256": {
        "darwin-arm64": "13e8828447f9081465ee0c35a61b24fb49296d51a310c6999227e2aed178956b",
        "darwin-x64": "6cf57fee0574daef2abed07f54a355fec3b93ac8f01733dc6c4d3674f1746112",
        "linux-arm64": "99e7d313a2ff85eaf23a6415e9b3aae67bf74c2fa169b21b93070ada7613f6a0",
        "linux-x64": "04ec685c56b42c29dff6db10fc7dc2c730217dc9c96736e53ad2acf3226dafb7"
      },
      "artifact": "gentle-ai",
      "dest": "~/.local/bin",
      "verify": [
        "gentle-ai --version"
      ],
      "archMap": {
        "x64": "amd64",
        "arm64": "arm64"
      }
    },
    "engram": {
      "kind": "tarball",
      "version": "3.6.2",
      "requires": [],
      "url": "https://github.com/Gentleman-Programming/engram/releases/download/v{version}/engram_{version}_{os}_{arch}.tar.gz",
      "sha256": {
        "darwin-arm64": "3d351cc01f17d90c81466483b4d97ddda7a59d9be29a0a2c3aabcdc6861f36e7",
        "darwin-x64": "bf14238b78f7fe57c1347842e388723d409ddf85d3a4314450835957862cf3db",
        "linux-arm64": "408491460c55ed6150e6582f6c32e1e10fe572e2cf68228415b9f8be719703e4",
        "linux-x64": "3527b7e7e8692fd4aaaf576d331cded19155523cf8b02c2de38744cccb229e89"
      },
      "artifact": "engram",
      "dest": "~/.local/bin",
      "verify": [
        "engram --version"
      ],
      "archMap": {
        "x64": "amd64",
        "arm64": "arm64"
      }
    },
    "codegraph": {
      "kind": "npm-global",
      "package": "@colbymchenry/codegraph",
      "version": "1.6.2",
      "requires": [
        "node"
      ],
      "exposes": [
        "codegraph"
      ],
      "verify": [
        "codegraph --version"
      ]
    },
    "claude-code": {
      "kind": "npm-global",
      "package": "@anthropic-ai/claude-code",
      "version": "2.1.318",
      "requires": [
        "node"
      ],
      "exposes": [
        "claude"
      ],
      "verify": [
        "claude --version"
      ],
      "tier": "auth:claude"
    },
    "gentle-shell": {
      "kind": "pi-package-bin",
      "package": "gentle-pi",
      "version": "4.6.0",
      "requires": [
        "node",
        "pi",
        "gentle-ai"
      ],
      "bin": "bin/gentle-shell.mjs",
      "shim": "~/.local/bin/gentle-shell",
      "home": "~/.gentle-shell",
      "note": "gentle-ai NO instala gentle-shell: es el shell que vive en el paquete gentle-pi. Su instalador oficial es un wizard de navegador; el `setup` del propio paquete hace lo mismo sin navegador (verificado).",
      "verify": [
        "gentle-shell --version"
      ],
      "exposes": [
        "gentle-shell"
      ]
    }
  },
  "pi": {
    "packages": [
      "npm:gentle-pi@4.6.0",
      "npm:gentle-engram@0.6.0",
      "npm:pi-claude-bridge@0.10.0",
      "npm:pi-web-access@0.47.0",
      "npm:@aliou/pi-processes@0.13.5",
      "npm:pi-btw@0.8.1",
      "npm:pi-image-tools@1.4.0",
      "git:https://github.com/hasit/pi-community-themes@a6d7731fd46db4721654bf45161fb2cd1e8cbc1e"
    ],
    "optionalPackages": [
      "npm:pi-browser-harness@0.14.0"
    ]
  },
  "agents": {
    "gentle-ai-install": {
      "command": "gentle-ai install --agent pi --scope global",
      "note": "Correr ANTES de añadir agentes propios: setup captura los .md presentes en disco."
    }
  },
  "config": [
    {
      "src": "config/pi/settings.json",
      "dest": "~/.pi/agent/settings.json",
      "merge": "json-shallow"
    },
    {
      "src": "config/pi/mcp.json",
      "dest": "~/.pi/agent/mcp.json",
      "merge": "json-shallow"
    },
    {
      "src": "config/pi/keybindings.json",
      "dest": "~/.pi/agent/keybindings.json",
      "merge": "json-shallow"
    },
    {
      "src": "config/pi/agents",
      "dest": "~/.pi/agent/agents",
      "merge": "copy-missing"
    },
    {
      "src": "config/gentle-ai/channel.json",
      "dest": "~/.pi/gentle-ai/channel.json",
      "merge": "copy"
    },
    {
      "src": "config/gentle-ai/background-subagents.json",
      "dest": "~/.pi/gentle-ai/background-subagents.json",
      "merge": "copy"
    }
  ],
  "derivedByProfile": [
    "~/.pi/agent/subagents.json",
    "~/.pi/gentle-ai/profiles.json",
    "~/.pi/agent/web-search.json"
  ],
  "neverCopy": [
    "~/.pi/agent/auth.json",
    "~/.pi/agent/deviceId",
    "~/.pi/agent/browser-harness.json",
    "~/.pi/agent/trust.json",
    "~/.pi/agent/models.json (llm-gateway/baseUrl/apiKey son del autor)",
    "~/.engram/engram.db"
  ],
  "gentleAi": {
    "agent": "pi",
    "scope": "global",
    "preset": "full-gentleman",
    "persona": "gentleman",
    "components": [
      "claude-theme",
      "context7",
      "persona",
      "engram",
      "opencode-gentle-logo",
      "permissions",
      "skills"
    ],
    "piBackgroundSubagents": "on",
    "channel": "stable",
    "note": "Componentes del preset full-gentleman, declarados explícitamente, menos gga. gga (Gentleman Guardian Angel) es un gate de revisión en pre-commit: queda fuera por defecto porque bloquea commits y necesita un CLI de proveedor mapeado; opt-in con --component gga. Con --agent pi el componente skills no escribe en disco: las skills de Pi vienen del paquete gentle-pi."
  }
}
