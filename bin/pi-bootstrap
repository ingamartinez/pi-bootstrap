#!/usr/bin/env bash
# pi-bootstrap — instalador de Pi + Gentle AI + perfil de modelos.
set -uo pipefail

SRC="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
. "$SRC/lib/common.sh"
. "$SRC/lib/pins.sh"
. "$SRC/lib/steps.sh"
. "$SRC/lib/verify.sh"
. "$SRC/lib/reset.sh"

TIERS="${PI_BOOTSTRAP_TIERS:-base,tools}"
TIERS_SET=0
PROFILE="${PI_BOOTSTRAP_PROFILE:-}"
PROFILE_REQUIRES=""
DEEPSEEK_VIA="${PI_BOOTSTRAP_DEEPSEEK_VIA:-}"
DEEPSEEK_VIA_SET=0
ASSUME_YES=0 DRY_RUN=0 SKIP_AUTH=0 FORCE=0 STRICT=0
RESET_CONFIG=0 RESET_TOOLS=0 RESET_SHELL=0 RESET_ALL=0 PURGE_AUTH=0
CMD=""
FORWARD=()

usage() {
  cat <<'EOF'
pi-bootstrap — deja Pi listo en macOS o Linux, sin sudo.

Uso:
  pi-bootstrap [install] [opciones]     instala y configura todo
  pi-bootstrap profiles                 lista los perfiles de modelos
  pi-bootstrap profile <id>             cambia el perfil activo
  pi-bootstrap auth                     revisa/conecta credenciales del perfil
  pi-bootstrap verify                   verifica que todo quedó bien
  pi-bootstrap doctor                   diagnóstico sin modificar nada
  pi-bootstrap init [dir]               prepara un repo (AGENTS.md, trust, codegraph)
  pi-bootstrap upgrade                  plan de actualización (no toca nada)
  pi-bootstrap upgrade --apply --yes    actualiza pins, reinstala y verifica
  pi-bootstrap upgrade --rollback       vuelve a la copia previa al último upgrade
  pi-bootstrap reset --config           borra la configuración que gestiona el bootstrap
  pi-bootstrap reset --all --yes        borra configuración + herramientas (+ --shell)
  pi-bootstrap export-config            re-snapshotea config/ desde esta máquina

Opciones:
  --tiers <lista>    base,tools,shell (default: base,tools)
  --profile <id>     perfil de modelos (si falta y hay TTY, pregunta)
  --deepseek-via <ruta>  deepseek (API directa) | opencode-go | none  (default: deepseek)
  --yes              no preguntar nada
  --dry-run          muestra el plan sin ejecutar
  --skip-auth        no abre logins (CI, contenedores)
  --force            re-aplica pasos ya hechos (gentle-ai install, agentes)
  --prefix <dir>     prefijo de instalación (default: ~/.local)
  --strict           verify falla también ante avisos

reset:
  --config | --tools | --shell | --all   qué borrar (siempre con backup de config)
  --purge-auth                            incluye auth.json/trust.json (irreversible)
EOF
}

while [ $# -gt 0 ]; do
  case "$1" in
    upgrade|update) CMD="$1"; shift; FORWARD=("$@"); break ;;
    install|profiles|profile|auth|verify|doctor|init|export-config|reset) CMD="$1"; shift ;;
    --config) RESET_CONFIG=1; shift ;;
    --tools) RESET_TOOLS=1; shift ;;
    --shell) RESET_SHELL=1; shift ;;
    --all) RESET_ALL=1; shift ;;
    --purge-auth) PURGE_AUTH=1; shift ;;
    --tiers) TIERS="$2"; TIERS_SET=1; shift 2 ;;
    --tiers=*) TIERS="${1#*=}"; TIERS_SET=1; shift ;;
    --profile) PROFILE="$2"; shift 2 ;;
    --profile=*) PROFILE="${1#*=}"; shift ;;
    --deepseek-via) DEEPSEEK_VIA="$2"; DEEPSEEK_VIA_SET=1; shift 2 ;;
    --deepseek-via=*) DEEPSEEK_VIA="${1#*=}"; DEEPSEEK_VIA_SET=1; shift ;;
    --yes|-y) ASSUME_YES=1; shift ;;
    --dry-run) DRY_RUN=1; shift ;;
    --skip-auth) SKIP_AUTH=1; shift ;;
    --force) FORCE=1; shift ;;
    --strict) STRICT=1; shift ;;
    --prefix) PREFIX="$2"; shift 2 ;;
    --prefix=*) PREFIX="${1#*=}"; shift ;;
    -h|--help) usage; exit 0 ;;
    *) die "opción desconocida: $1 (usa --help)" ;;
  esac
done
export ASSUME_YES DRY_RUN SKIP_AUTH FORCE STRICT PREFIX
export RESET_CONFIG RESET_TOOLS RESET_SHELL RESET_ALL PURGE_AUTH

profile_independence_text() {
  # profile_independence_text <archivo.json>
  case "$(profile_field "$1" independence)" in
    cross-provider) printf 'familias distintas' ;;
    same-family)    printf 'misma familia' ;;
    *)              printf 'sin declarar' ;;
  esac
}

list_profiles() {
  local f id label reqs indep
  for f in "$SRC"/config/profiles/*.json; do
    [ -f "$f" ] || continue
    id=$(basename "$f" .json)
    label=$(profile_field "$f" label)
    [ -n "$label" ] || label="(sin descripción)"
    reqs=$(profile_list_field "$f" requires)
    indep=$(profile_independence_text "$f")
    printf '  %-31s %s\n' "$id" "$label"
    printf '  %-31s %s · requiere: %s\n\n' "" "$indep" "$reqs"
  done
}

load_profile_meta() {
  [ -n "$PROFILE" ] || return 0
  local f="$SRC/config/profiles/$PROFILE.json" raw
  [ -f "$f" ] || die "perfil desconocido: $PROFILE (usa: pi-bootstrap profiles)"
  raw=$(profile_list_field "$f" requires)
  if [ "${DEEPSEEK_VIA:-deepseek}" = "none" ]; then
    case "$raw" in
      *deepseek*)
        die "el perfil $PROFILE requiere DeepSeek y la ruta elegida es 'none'.
  Usa --deepseek-via deepseek|opencode-go, o elige un perfil sin DeepSeek (full-claude, full-openai,
  claude-produces-openai-verifies, openai-produces-claude-verifies)." ;;
    esac
  fi
  PROFILE_REQUIRES=$(profile_requires "$f" "${DEEPSEEK_VIA:-deepseek}")
  export PROFILE PROFILE_REQUIRES
}

profile_requires() {
  # profile_requires <archivo.json> [ruta] → proveedores, con deepseek ya enrutado a opencode-go
  local f="$1" route="${2:-deepseek}" out="" p
  for p in $(profile_list_field "$f" requires | tr ',' ' '); do
    [ "$route" = "opencode-go" ] && [ "$p" = "deepseek" ] && p="opencode-go"
    out="$out $p"
  done
  printf '%s' "${out# }"
}

resolve_deepseek_via() {
  # Prioridad: flag/env > ruta registrada por la última instalación > deepseek (API directa)
  if [ -z "${DEEPSEEK_VIA:-}" ]; then
    local state="$HOME/.pi-bootstrap/installed.json" recorded=""
    [ -f "$state" ] && recorded=$(profile_field "$state" deepseekVia)
    DEEPSEEK_VIA="${recorded:-deepseek}"
  fi
  export DEEPSEEK_VIA PI_BOOTSTRAP_DEEPSEEK_VIA="$DEEPSEEK_VIA"
}

ask_deepseek_route() {
  # No se pregunta si la ruta ya está decidida: por flag (--deepseek-via) o por entorno
  # (PI_BOOTSTRAP_DEEPSEEK_VIA); y nunca con --yes. Si no, un install no interactivo se quedaría
  # esperando y podría pisar la ruta elegida.
  [ "${DEEPSEEK_VIA_SET:-0}" = "1" ] && return 0
  [ -n "${DEEPSEEK_VIA:-}" ] && return 0
  [ "${ASSUME_YES:-0}" = "1" ] && return 0
  interactive || return 0
  log ""
  log "¿Cómo quieres DeepSeek? (decide qué perfiles tienen sentido para ti)"
  printf '  1) API directa — DEEPSEEK_API_KEY       [deepseek]\n' >&2
  printf '  2) Vía opencode-go — OPENCODE_API_KEY   [opencode-go]\n' >&2
  printf '  3) Sin DeepSeek — sólo Claude / OpenAI  [none]\n' >&2
  printf 'Ruta [1]: ' >&2
  local answer=""; prompt_read answer || answer=""
  case "$answer" in
    2|opencode-go) DEEPSEEK_VIA="opencode-go" ;;
    3|none)        DEEPSEEK_VIA="none" ;;
    *)            DEEPSEEK_VIA="deepseek" ;;
  esac
  export DEEPSEEK_VIA PI_BOOTSTRAP_DEEPSEEK_VIA="$DEEPSEEK_VIA"
}

ask_profile() {
  [ -n "$PROFILE" ] && return 0
  local route="${DEEPSEEK_VIA:-deepseek}" avail="" f
  for f in "$SRC"/config/profiles/*.json; do
    [ -f "$f" ] || continue
    if [ "$route" = "none" ]; then
      case "$(profile_list_field "$f" requires)" in *deepseek*) continue ;; esac
    fi
    avail="$avail $(basename "$f" .json)"
  done
  # Sin terminal no se inventa una elección: se pide explícita, y se explica por qué.
  if ! interactive; then
    die "falta --profile. Disponibles (ruta $route):$avail
  · modo interactivo: clona el repo y corre ./bootstrap.sh
  · one-shot:         --profile <id> --yes [--deepseek-via deepseek|opencode-go|none]"
  fi
  log ""
  log "¿Qué perfil de modelos quieres?"
  log "  Quien produce no debería ser quien verifica: en 'familias distintas' el gate es real;"
  log "  en 'misma familia' todo corre en un proveedor (más barato, no apto para gates críticos)."
  [ "$route" = "none" ] && log "  Filtrado a perfiles sin DeepSeek (elegiste la ruta 'none')."
  [ "$route" = "opencode-go" ] && log "  Los modelos DeepSeek se aplican por opencode-go (OPENCODE_API_KEY)."
  log ""
  local ids="" i=1 label indep
  for f in "$SRC"/config/profiles/*.json; do
    [ -f "$f" ] || continue
    if [ "$route" = "none" ]; then
      case "$(profile_list_field "$f" requires)" in *deepseek*) continue ;; esac
    fi
    ids="$ids $(basename "$f" .json)"
    label=$(profile_field "$f" label)
    [ -n "$label" ] || label="$(basename "$f" .json)"
    indep=$(profile_independence_text "$f")
    printf '  %d) %-31s %s [%s]\n' "$i" "$(basename "$f" .json)" "$label" "$indep" >&2
    i=$((i + 1))
  done
  local default=full-claude
  printf 'Número o id [%s]: ' "$default" >&2
  local answer=""; prompt_read answer || answer=""
  case "$answer" in
    "") PROFILE="$default" ;;
    *[!0-9]*) PROFILE="$answer" ;;
    *) PROFILE=$(printf '%s\n' $ids | sed -n "${answer}p") ;;
  esac
  export PROFILE
}

ask_tiers() {
  [ "${TIERS_SET:-0}" = "1" ] && return 0
  interactive || return 0
  case ",$TIERS," in
    *",shell,"*) return 0 ;;
  esac
  if ask_yes_no "¿Instalar también el tier shell (gentle-shell, home aislado)?" n; then
    TIERS="$TIERS,shell"
    export TIERS
  fi
}

ask_auth_preference() {
  [ "${SKIP_AUTH:-0}" = "1" ] && return 0
  interactive || return 0
  if ! ask_yes_no "¿Conectar credenciales ahora (abre la TUI de pi / Claude Code)?" s; then
    SKIP_AUTH=1
    export SKIP_AUTH
    log "  ok: lo dejas para después con 'pi-bootstrap auth'"
  fi
}

cmd_install() {
  preflight
  ask_deepseek_route
  resolve_deepseek_via
  ask_profile
  ask_tiers
  ask_auth_preference
  load_profile_meta

  step "plan"
  log "  tiers:   $TIERS"
  log "  deepseek: $DEEPSEEK_VIA$( [ "$DEEPSEEK_VIA" = "none" ] && echo ' (el perfil no lo usa)' )"
  log "  perfil:  ${PROFILE:-<sin definir>}${PROFILE_REQUIRES:+ (proveedores: $PROFILE_REQUIRES)}"
  log "  auth:    $( [ "$SKIP_AUTH" = "1" ] && echo 'después (pi-bootstrap auth)' || echo 'ahora' )"
  log "  prefijo: $PREFIX"
  log "  pasos:   preflight → binarios → gentle-ai → paquetes pi → config → perfil → auth → verify"

  if [ "$DRY_RUN" = "1" ]; then
    log ""
    log "(--dry-run) nada modificado"
    return 0
  fi

  if ! confirm "¿Procedo con la instalación?"; then
    log "cancelado"; return 1
  fi

  install_tier_tools
  load_profile_meta
  install_provider_tools
  setup_gentle_ai
  install_pi_packages
  apply_config
  apply_profile
  install_gentle_shell
  # `gentle-shell setup` corre gentle-ai install, que puede regenerar profiles.json:
  # se re-aplica el perfil para que el runtime del home principal quede como debe.
  apply_profile
  auth_gate
  ensure_path
  verify_all
  node "$SRC/scripts/record-state.mjs" "$TIERS" "$PROFILE" || warn "no se pudo registrar el estado instalado"
}

case "$CMD" in
  ""|install) cmd_install ;;
  profiles) list_profiles ;;
  profile)
    resolve_deepseek_via
    load_profile_meta
    step "aplicando perfil $PROFILE (deepseek vía $DEEPSEEK_VIA)"
    apply_profile
    ;;
  auth)
    detect_platform
    resolve_deepseek_via
    load_profile_meta
    [ -n "$PROFILE_REQUIRES" ] || PROFILE_REQUIRES=$(node -e "const p=require('$SRC/config/profiles/'+require('fs').readdirSync('$SRC/config/profiles')[0]); process.stdout.write(p.requires.join(' '))" 2>/dev/null || true)
    auth_gate
    ;;
  verify)
    detect_platform
    resolve_deepseek_via
    load_profile_meta
    verify_all
    ;;
  doctor)
    preflight
    resolve_deepseek_via
    load_profile_meta
    verify_all
    ;;
  init)
    detect_platform
    init_project "${1:-$PWD}"
    ;;
  upgrade|update)
    exec node "$SRC/scripts/upgrade.mjs" ${FORWARD[@]+"${FORWARD[@]}"}
    ;;
  reset)
    detect_platform
    cmd_reset
    ;;
  export-config)
    node "$SRC/scripts/export-config.mjs" ;;
  *) usage; exit 2 ;;
esac
