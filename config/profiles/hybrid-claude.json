{
  "schema": "pi-bootstrap.profile/1",
  "id": "hybrid-claude",
  "label": "Híbrido — DeepSeek para volumen, Claude para verificar",
  "requires": [
    "deepseek",
    "claude"
  ],
  "independence": "cross-provider",
  "roles": {
    "orchestrator": {
      "model": "deepseek/deepseek-v4-pro",
      "thinking": "high"
    },
    "gentle-ai-explore": {
      "model": "deepseek/deepseek-flash",
      "thinking": "low"
    },
    "gentle-ai-worker": {
      "model": "deepseek/deepseek-v4-pro",
      "thinking": "high"
    },
    "gentle-ai-verify": {
      "model": "claude-bridge/claude-sonnet-5-5",
      "thinking": "high"
    },
    "review-readability": {
      "model": "deepseek/deepseek-flash",
      "thinking": "high"
    },
    "review-resilience": {
      "model": "deepseek/deepseek-flash",
      "thinking": "high"
    },
    "review-reliability": {
      "model": "deepseek/deepseek-flash",
      "thinking": "high"
    },
    "review-risk": {
      "model": "claude-bridge/claude-opus-5-5",
      "thinking": "high"
    },
    "review-refuter": {
      "model": "claude-bridge/claude-opus-5-5",
      "thinking": "high"
    },
    "review-validator": {
      "model": "claude-bridge/claude-sonnet-5-5",
      "thinking": "high"
    },
    "jd-judge-a": {
      "model": "claude-bridge/claude-opus-5-5",
      "thinking": "high"
    },
    "jd-judge-b": {
      "model": "deepseek/deepseek-v4-pro",
      "thinking": "high"
    },
    "jd-fix-agent": {
      "model": "deepseek/deepseek-v4-pro",
      "thinking": "high"
    }
  },
  "settings": {
    "defaultProvider": "deepseek",
    "defaultModel": "deepseek-v4-pro",
    "defaultThinkingLevel": "high"
  },
  "webSearch": null,
  "notes": [
    "DeepSeek necesita DEEPSEEK_API_KEY propia (el modelo deepseek-v4.1-flash sólo existe en opencode-go).",
    "Claude consume cuota de subscripción vía Claude Code, no facturación por API."
  ]
}
