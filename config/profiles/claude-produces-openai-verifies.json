{
  "schema": "pi-bootstrap.profile/1",
  "id": "claude-produces-openai-verifies",
  "label": "Claude produce · OpenAI verifica",
  "requires": [
    "claude",
    "openai"
  ],
  "independence": "cross-provider",
  "roles": {
    "orchestrator": {
      "model": "claude-bridge/claude-sonnet-5-5",
      "thinking": "high"
    },
    "gentle-ai-explore": {
      "model": "claude-bridge/claude-haiku-5-5",
      "thinking": "low"
    },
    "gentle-ai-worker": {
      "model": "claude-bridge/claude-sonnet-5-5",
      "thinking": "high"
    },
    "gentle-ai-verify": {
      "model": "openai/gpt-6.1-sol",
      "thinking": "high"
    },
    "review-readability": {
      "model": "claude-bridge/claude-haiku-5-5",
      "thinking": "high"
    },
    "review-resilience": {
      "model": "claude-bridge/claude-haiku-5-5",
      "thinking": "high"
    },
    "review-reliability": {
      "model": "claude-bridge/claude-haiku-5-5",
      "thinking": "high"
    },
    "review-risk": {
      "model": "openai/gpt-6.1-sol",
      "thinking": "high"
    },
    "review-refuter": {
      "model": "openai/gpt-6.1-sol",
      "thinking": "high"
    },
    "review-validator": {
      "model": "openai/gpt-6-sol",
      "thinking": "high"
    },
    "jd-judge-a": {
      "model": "openai/gpt-6.1-sol",
      "thinking": "high"
    },
    "jd-judge-b": {
      "model": "claude-bridge/claude-opus-5-5",
      "thinking": "high"
    },
    "jd-fix-agent": {
      "model": "claude-bridge/claude-sonnet-5-5",
      "thinking": "high"
    }
  },
  "settings": {
    "defaultProvider": "claude-bridge",
    "defaultModel": "claude-sonnet-5-5",
    "defaultThinkingLevel": "high"
  },
  "webSearch": {
    "provider": "openai",
    "model": "gpt-6-luna"
  },
  "notes": [
    "Requiere el binario `claude` logueado (plan Pro/Max) y OpenAI con /login en pi.",
    "Produce con Claude y verifica con OpenAI: el gate de revisión no comparte familia."
  ]
