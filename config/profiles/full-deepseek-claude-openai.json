{
  "schema": "pi-bootstrap.profile/1",
  "id": "full-deepseek-claude-openai",
  "label": "DeepSeek volumen · Claude verifica · OpenAI riesgo/jueces",
  "requires": [
    "deepseek",
    "claude",
    "openai"
  ],
  "independence": "cross-provider",
  "roles": {
    "orchestrator": {
      "model": "deepseek/deepseek-v4-pro",
      "thinking": "high"
    },
    "gentle-ai-explore": {
      "model": "deepseek/deepseek-flash",
      "thinking": "low"
    },
    "gentle-ai-worker": {
      "model": "deepseek/deepseek-flash",
      "thinking": "high"
    },
    "gentle-ai-verify": {
      "model": "claude-bridge/claude-sonnet-5-5",
      "thinking": "high"
    },
    "review-readability": {
      "model": "deepseek/deepseek-flash",
      "thinking": "high"
    },
    "review-resilience": {
      "model": "deepseek/deepseek-flash",
      "thinking": "high"
    },
    "review-reliability": {
      "model": "deepseek/deepseek-flash",
      "thinking": "high"
    },
    "review-risk": {
      "model": "openai/gpt-6.1-sol",
      "thinking": "high"
    },
    "review-refuter": {
      "model": "openai/gpt-6.1-sol",
      "thinking": "high"
    },
    "review-validator": {
      "model": "claude-bridge/claude-sonnet-5-5",
      "thinking": "high"
    },
    "jd-judge-a": {
      "model": "openai/gpt-6.1-sol",
      "thinking": "high"
    },
    "jd-judge-b": {
      "model": "claude-bridge/claude-opus-5-5",
      "thinking": "high"
    },
    "jd-fix-agent": {
      "model": "deepseek/deepseek-v4-pro",
      "thinking": "high"
    }
  },
  "settings": {
    "defaultProvider": "deepseek",
    "defaultModel": "deepseek-v4-pro",
    "defaultThinkingLevel": "high"
  },
  "webSearch": {
    "provider": "openai",
    "model": "gpt-6-luna"
  },
  "notes": [
    "Los tres proveedores: DeepSeek para volumen, Claude para verificar, OpenAI para riesgo y jueces.",
    "Aunque se llame 'full', es cross-provider: por eso sirve para gates críticos."
  ]
}
